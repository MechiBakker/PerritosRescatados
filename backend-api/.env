# Clave de API para Mercado Pago (Obtenida de tu panel de desarrollador)
MERCADO_PAGO_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_PRODUCCION_O_SANDBOX

# Clave pública para la API de Google Sheets (más seguro: usar credenciales de servicio)
# Para una POC rápida, puedes usar una API Key restringida
GOOGLE_SHEETS_API_KEY=TU_CLAVE_API_DE_GOOGLE

# ID de tu Google Sheet
GOOGLE_SHEET_ID=EL_ID_LARGO_DE_TU_HOJA_DE_CALCULO